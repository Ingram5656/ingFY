{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ingfy",
  "version": "2.0.0",
  "identifier": "com.nige.lyrics",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "ingfy",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 640,
        "center": true,
        "visible": false
      },
      {
        "label": "desktop",
        "create": false,
        "title": "ingfy 桌面歌词",
        "width": 1000,
        "height": 240,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": true,
        "focus": false,
        "visible": false
      },
      {
        "label": "island",
        "create": false,
        "title": "ingfy 灵动岛",
        "width": 448,
        "height": 64,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "focus": false,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "publisher": "ingfy",
    "copyright": "© 2026 ingfy",
    "category": "Music",
    "shortDescription": "液态玻璃风格的动态歌词",
    "longDescription": "ingfy 读取电脑上正在播放的歌曲，显示全屏卡拉 OK 歌词、桌面歌词和随音乐跳动的拾音灯，支持网易云逐字歌词、唱片模式和 Spotify 收藏。",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "nsis": {
        "languages": [
          "SimpChinese",
          "English"
        ],
        "displayLanguageSelector": false,
        "installMode": "currentUser"
      }
    }
  }
}
